# The app remains usable in safe fallback mode when this is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=sqlite:///./data/arbitragem.db
POSTGRES_DB=arbitragem
POSTGRES_USER=arbitragem
POSTGRES_PASSWORD=change-this-password
PLATFORM_SIGNING_SECRET=

# development | production. Em produção, PLATFORM_SIGNING_SECRET vazio derruba
# o boot: toda a assinatura do manifesto depende desse segredo.
APP_ENV=development

# Chave privada Ed25519 que assina as Decision Attestations (enforcement
# externo do escrow). Seed de 32 bytes em base64.
# Gerar com: python -m app.core.attestation
# Se vazia, a emissão de attestations fica desabilitada (o restante do
# sistema funciona normalmente).
PLATFORM_ED25519_PRIVATE_KEY=

# Dias da janela de contestação após a emissão da attestation, antes de o
# executor externo poder liquidar o escrow.
CONTEST_WINDOW_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
AUTH_REQUIRED=false

# URL pública base usada nos links de convite enviados por e-mail.
APP_BASE_URL=http://127.0.0.1:8000

# Entrega de e-mail transacional (convites e notificações). Sem SMTP_HOST e
# EMAIL_FROM, o sistema entra em modo "logged": a mensagem é registrada no log
# em vez de enviada, e o link do convite continua disponível na resposta da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# STARTTLS na porta 587 (padrão) ou TLS direto (SSL) na porta 465.
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
