# The app remains usable in safe fallback mode when this is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=sqlite:///./data/arbitragem.db
POSTGRES_DB=arbitragem
POSTGRES_USER=arbitragem
POSTGRES_PASSWORD=change-this-password
PLATFORM_SIGNING_SECRET=

# development | production. Em produção, PLATFORM_SIGNING_SECRET vazio derruba
# o boot: toda a assinatura do manifesto depende desse segredo.
APP_ENV=development

# Chave privada Ed25519 que assina as Decision Attestations (enforcement
# externo do escrow). Seed de 32 bytes em base64.
# Gerar com: python -m app.core.attestation
# Se vazia, a emissão de attestations fica desabilitada (o restante do
# sistema funciona normalmente).
PLATFORM_ED25519_PRIVATE_KEY=

# Dias da janela de contestação após a emissão da attestation, antes de o
# executor externo poder liquidar o escrow.
CONTEST_WINDOW_DAYS=7

# Dias do prazo de ciência e resposta que o rito abre para a contraparte
# assim que um material é disponibilizado. Vencido sem manifestação, a
# oportunidade preclui e o procedimento segue.
CONTRADICTORY_RESPONSE_DAYS=7

# Dias que cada parte tem para declarar encerrada a própria produção de
# material depois que o contraditório se completa. Vencido sem
# manifestação, o rito encerra por decurso de prazo.
SUBMISSION_CLOSURE_DAYS=7

# Dias que cada parte tem para ratificar (ou recusar) uma decisão que a
# auditoria ressalvou. Vencido sem manifestação, o caso encerra sem
# decisão executável: silêncio nunca vale como aceite.
RATIFICATION_DAYS=7

# Teto de rodadas de composição por caso. Protege o procedimento contra um
# agente que insista em recomendar novas rodadas indefinidamente.
COMPOSITION_MAX_ROUNDS=5

# Publica uma âncora pública da attestation em relays Nostr (NIP-78, kind
# 30078): apenas hash + assinatura + identificadores, nunca o teor da decisão
# ou das partes. Dá timestamp e disponibilidade independentes do servidor da
# Valinor. Opcional — sem chave ou sem relay configurado, a publicação é
# pulada e o resto do fluxo de attestation funciona normalmente.
# Chave secp256k1 em hex. Gerar com: python -m app.core.nostr_anchor
NOSTR_PRIVATE_KEY_HEX=
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760

# Exige conta autenticada nas consultas. Em APP_ENV=production isto é forçado
# para true e o modo de tokens por papel é desabilitado.
AUTH_REQUIRED=true

# Rate limiting por IP (janela deslizante em memória). Em produção fica ligado
# por padrão; em desenvolvimento só entra se RATE_LIMIT_ENABLED=true.
RATE_LIMIT_ENABLED=
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# URL pública usada para montar o link de aceite do convite — o único caminho
# de entrada da contraparte no caso. Em APP_ENV=production o boot falha se
# apontar para localhost: o convite nasceria inutilizável.
PUBLIC_BASE_URL=http://localhost:8000

# Envio transacional de convites. Sem SMTP_HOST/SMTP_FROM o convite é apenas
# registrado no log (o token de aceite continua disponível no modo local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Armazenamento dos documentos (fora do banco). O banco guarda apenas
# metadados e hashes; os bytes ficam no object store.
#   local (padrão) | s3 | memory (apenas testes)
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=./data/documents
# Para DOCUMENT_STORAGE_BACKEND=s3 (AWS, MinIO, R2, etc.):
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=
DOCUMENT_S3_ENDPOINT_URL=
DOCUMENT_S3_REGION=

# Criptografia dos documentos e do texto dos chunks em repouso (AES-256-GCM).
# Base64 de 32 bytes. Vazia = gravados em claro. Gere com:
#   python -m app.core.encryption
# Obrigatória quando APP_ENV=production: o boot falha sem ela.
DOCUMENT_ENCRYPTION_KEY=

# Validade (segundos) dos links de download temporários e assinados.
DOWNLOAD_URL_TTL_SECONDS=300
