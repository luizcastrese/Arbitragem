APP_ENV=development
# The app remains usable in safe fallback mode when this is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REVIEW_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=sqlite:///./data/arbitragem.db
POSTGRES_DB=arbitragem
POSTGRES_USER=arbitragem
POSTGRES_PASSWORD=
PLATFORM_SIGNING_SECRET=
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
AUTH_REQUIRED=true
ALLOW_LEGACY_CASE_TOKENS=false
EXPOSE_AUTH_TOKENS=false
SECURE_COOKIES=false
SESSION_COOKIE_NAME=valinor_session
RATE_LIMIT_PER_MINUTE=120
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=http://127.0.0.1:8000
